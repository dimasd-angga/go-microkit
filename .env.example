# Copy to .env and adjust for your environment.

# --- service ports ---
USER_SERVICE_GRPC_PORT=50051
ORDER_SERVICE_GRPC_PORT=50052
NOTIFICATION_SERVICE_GRPC_PORT=50053
GATEWAY_PORT=8080

# --- postgres ---
POSTGRES_DSN=postgres://microkit:microkit@localhost:5432/microkit?sslmode=disable

# --- redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- nats ---
NATS_URL=nats://localhost:4222

# --- auth ---
JWT_SECRET=change-me-in-production-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# --- telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=go-microkit
OTEL_ENABLED=true

# --- runtime ---
LOG_LEVEL=info
ENV=development
